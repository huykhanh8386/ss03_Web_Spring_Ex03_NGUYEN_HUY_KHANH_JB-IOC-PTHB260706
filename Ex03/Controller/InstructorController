package com.example.session03.Controller;

import com.example.session03.Models.Entities.Instructor;
import com.example.session03.Models.Responses.ApiResponse;
import com.example.session03.Models.Services.InstructorService;
import lombok.RequiredArgsConstructor;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

@RestController
@RequiredArgsConstructor
@RequestMapping("/api/v3/instructor")
public class InstructorController {
    private final InstructorService instructorService;
    @GetMapping
    public ResponseEntity<?> findAll() {
        return ResponseEntity.status(HttpStatus.OK).body(new ApiResponse<>(true, "Lấy danh sách giảng viên thành công", instructorService.findAll()));
    }
    @GetMapping("/{id}")
    public ResponseEntity<?> findById(@PathVariable int id) {
        Instructor instructor = instructorService.getInstructorById(id);
        if (instructor == null) {
            return ResponseEntity.status(HttpStatus.NOT_FOUND).body(new ApiResponse<>(false, "Không au tìm thấy giảng viên", null));
        }
        return ResponseEntity.status(HttpStatus.OK).body(new ApiResponse<>(true, "Lấy giảng viên thành công", instructor));
    }
    @PostMapping
    public ResponseEntity<?> create(@RequestBody Instructor instructor) {
        if (instructor.getName() == null
                || instructor.getName().isBlank()
                || instructor.getEmail() == null
                || instructor.getEmail().isBlank()) {
            return ResponseEntity.status(HttpStatus.BAD_REQUEST).body("Dữ liệu không hợp lệ");
        }
        Instructor result = instructorService.createInstructor(instructor);
        if (result == null) {
            return ResponseEntity.status(HttpStatus.BAD_REQUEST).body(new ApiResponse<>(false, "tạo giảng viên thất bại", null));
        }
        return ResponseEntity.status(HttpStatus.CREATED).body(new ApiResponse<>(true, "Lấy giảng viên thành công", result));
    }
    @PutMapping("/{id}")
    public ResponseEntity<?> update(@PathVariable int id, @RequestBody Instructor instructor) {
        if (instructor.getName() == null
                || instructor.getName().isBlank()
                || instructor.getEmail() == null
                || instructor.getEmail().isBlank()) {
            return ResponseEntity.status(HttpStatus.BAD_REQUEST).body("Dữ liệu không hợp lệ");
        }
        Instructor result = instructorService.updateInstructor(id, instructor);
        if (result == null) {
            return ResponseEntity.status(HttpStatus.NOT_FOUND).body(new ApiResponse<>(false, "Không tìm thấy giảng viên", null));
        }
        return ResponseEntity.ok(new ApiResponse<>(true, "Cập nhật giảng viên thành công", result));
    }
    @DeleteMapping("/{id}")
    public ResponseEntity<?> delete(@PathVariable int id) {
        Instructor result = instructorService.deleteInstructorById(id);
        if (result == null) {
            return ResponseEntity.status(HttpStatus.NOT_FOUND).body(new ApiResponse<>(false, "Không tìm thấy giảng viên", null));
        }
        return ResponseEntity.ok(new ApiResponse<>(true, "Xóa giảng viên thành công", result));
    }
}
